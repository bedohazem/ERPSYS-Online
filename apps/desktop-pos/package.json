{
  "name": "@erpsys/desktop-pos",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron \"vite --host 127.0.0.1 --port 5174\" \"npm run dev:electron\"",
    "dev:electron": "wait-on tcp:5174 && tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit && vite build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "wait-on": "^9.1.0"
  }
}
