{
  "name": "erpsys-online",
  "version": "1.0.0",
  "description": "Professional online ERP system.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:web-admin": "npm --prefix apps/web-admin run build",
    "build:desktop-pos": "npm --prefix apps/desktop-pos run build",
    "desktop-pos:dev": "npm --prefix apps/desktop-pos run dev",
    "check": "npm run typecheck && npm run build:web-admin && npm run build:desktop-pos",
    "test": "npm run test:unit && npm run check",
    "test:unit": "tsx --test tests/auth/password.test.ts",
    "db:migrate": "node packages/database/scripts/migrate.js",
    "db:seed": "node packages/database/scripts/seed.js",
    "api:dev": "tsx watch services/api/src/server.ts",
    "api:start": "tsx services/api/src/server.ts",
    "auth:set-password": "tsx packages/auth/scripts/set-user-password.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedohazem/ERPSYS-Online.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bedohazem/ERPSYS-Online/issues"
  },
  "homepage": "https://github.com/bedohazem/ERPSYS-Online#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
